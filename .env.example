# Copy to .env.local for local development, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.

# --- Database: Neon Postgres (neon.tech -> your project -> Connect) ----------------
# The pooled connection string, e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Login (Arjun only) -----------------------------------------------------------
ADMIN_EMAIL=
# At least 8 characters.
ADMIN_PASSWORD=
# Any random string of 32+ characters, used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Google Gemini (aistudio.google.com -> Get API key) -----------------------------
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash. Use gemini-3.1-pro-preview for the Pro model.
GEMINI_MODEL=

# --- Resend (resend.com -> API keys) --------------------------------------------------
# Leave empty to record emails in the app without delivering them.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Until then, leave empty to use onboarding@resend.dev.
EMAIL_FROM_ADDRESS=
# Display name on every email (defaults to "Arjun Mehta").
EMAIL_FROM_NAME=
# Where candidate replies go (Arjun's inbox).
EMAIL_REPLY_TO=

# --- Test mode --------------------------------------------------------------------------
# ON unless set to exactly "false". While on, every email goes to TEST_MODE_EMAIL
# instead of the candidate, with the real recipient in the subject line.
# Set TEST_MODE=false when the candidates' own addresses are safe test addresses.
TEST_MODE=
TEST_MODE_EMAIL=

# --- Local demo -------------------------------------------------------------------------
# "true" runs the app with no keys: local data in .demo-data/, no login, emails
# recorded but never sent, keyword scorer instead of Gemini (unless
# GEMINI_API_KEY is set). Ignored on Vercel. Leave empty in production.
DEMO_MODE=
