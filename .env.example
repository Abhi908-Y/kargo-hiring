# Copy to .env.local for local development, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.

# --- Supabase (Project Settings -> API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. Safe in the browser: RLS blocks all table access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key. Server only, never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Login ------------------------------------------------------------------
# The only account allowed to sign in (create it in Supabase -> Authentication -> Users).
ADMIN_EMAIL=

# --- Anthropic (console.anthropic.com -> API keys) ----------------------------
ANTHROPIC_API_KEY=

# --- Resend (resend.com -> API keys) -----------------------------------------
# Leave empty to simulate emails (they are recorded in the app but not delivered).
RESEND_API_KEY=
# Must be on a domain verified in Resend. Until then, leave empty to use onboarding@resend.dev.
EMAIL_FROM_ADDRESS=
# Display name on every email (defaults to "Arjun Mehta").
EMAIL_FROM_NAME=
# Where candidate replies go (Arjun's inbox).
EMAIL_REPLY_TO=

# --- Test mode ----------------------------------------------------------------
# ON unless set to exactly "false". While on, every email goes to TEST_MODE_EMAIL
# instead of the candidate, with the real recipient in the subject line.
TEST_MODE=
TEST_MODE_EMAIL=

# --- Local demo -----------------------------------------------------------------
# "true" runs the app with no keys: local data in .demo-data/, no login, emails
# recorded but never sent, keyword scorer instead of Claude (unless
# ANTHROPIC_API_KEY is set). Ignored on Vercel. Leave empty in production.
DEMO_MODE=
